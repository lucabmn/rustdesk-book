# ---------------------------------------------------------------------------
# rustdesk-book — environment configuration
# Copy to .env (production) or .env.local (development) and fill in.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://rustdesk:rustdesk@localhost:5432/rustdesk_book"

# Public base URL of this instance (used by better-auth for cookies/redirects).
BETTER_AUTH_URL="http://localhost:3000"

# Session signing secret. Generate with: npx -y @better-auth/cli secret
BETTER_AUTH_SECRET=""

# REQUIRED. 32-byte key that encrypts device passwords at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# ⚠  Must differ from BETTER_AUTH_SECRET. Losing this key makes every stored
#    device password permanently unrecoverable — back it up separately.
APP_ENCRYPTION_KEY=""

# Optional. Trust reverse-proxy client IP headers for per-IP enrollment rate
# limits. Enable only when the app is reachable exclusively through a proxy
# that strips and rewrites X-Forwarded-For / X-Real-IP. While this is off,
# audit entries record no IP address (the user agent is recorded either way).
# TRUST_PROXY_HEADERS="true"

# Optional. Bearer token that enables the read-only MCP endpoint (/mcp).
# Leave empty to disable MCP entirely. Generate with: openssl rand -hex 32
MCP_API_KEY=""

# ---------------------------------------------------------------------------
# Optional. Live device-status sync against your own RustDesk server.
# Real online/offline status is only available if you self-host a RustDesk
# server that exposes a peers API (e.g. RustDesk Server Pro). Leave
# RUSTDESK_API_URL empty to keep the status field fully manual.
# When configured, the polled status OVERWRITES the manual status.
# ---------------------------------------------------------------------------
RUSTDESK_API_URL=""
# Bearer token / API key, if your server requires one.
RUSTDESK_API_KEY=""
# Peers endpoint path (default: /api/peers). Adjust to match your server.
# The response JSON shape is parsed defensively but NOT verified against a
# specific server version — confirm field names against your instance.
RUSTDESK_API_PATH="/api/peers"
# Minimum seconds between polls (default: 30). Sync runs on device-list loads.
RUSTDESK_SYNC_TTL="30"
